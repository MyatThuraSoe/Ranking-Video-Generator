# Local user data - never commit personal projects, settings or licences.
# Rules anchored to the top of this folder: source runs create these next to
# main.py, but the checked-in factory seed under seed/ must stay tracked.
/states/
/templates/
/app_settings.json
/license.json
/license.json.tmp

# Python cache and local virtualenv
__pycache__/
*.py[cod]
.venv/

# Packaging outputs and staged binaries (regenerated by build_linux.py)
/build/
/dist/
/packaging/
